---
import { SITE } from '../config/site';
---

<!-- ===== HEADER / NAVEGACIÓN ===== -->
<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <!-- Glassmorphism background applied via JS scroll -->
  <div
    id="nav-inner"
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16 lg:h-18"
  >
    <!-- Logo -->
    <a
      href="#inicio"
      class="flex items-center gap-2.5 group"
      aria-label="Credixa33 - Inicio"
    >
      <!-- Isotipo SVG financiero estilizado -->
      <div
        class="w-9 h-9 bg-brand-500 rounded-xl flex items-center justify-center shadow-md group-hover:bg-brand-600 transition-colors duration-200"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="white"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 6v6l4 2"/>
          <path d="M9 12h6"/>
        </svg>
      </div>
      <span
        class="text-xl font-extrabold tracking-tight text-[#111827] group-hover:text-brand-500 transition-colors duration-200"
      >
        Credixa<span class="text-brand-500">33</span>
      </span>
    </a>

    <!-- Nav Desktop -->
    <nav class="hidden lg:flex items-center gap-1" role="navigation" aria-label="Menú principal">
      {
        SITE.nav.map((item) => (
          <a
            href={item.href}
            class="px-3.5 py-2 text-sm font-medium text-[#4B5563] hover:text-brand-500 hover:bg-brand-50 rounded-lg transition-all duration-200 relative group"
          >
            {item.label}
            <span class="absolute bottom-1 left-1/2 -translate-x-1/2 w-0 group-hover:w-4 h-0.5 bg-brand-500 transition-all duration-300 rounded-full"/>
          </a>
        ))
      }
    </nav>

    <!-- CTA Desktop + Mobile menu button -->
    <div class="flex items-center gap-3">
      <!-- WhatsApp CTA -->
      <a
        href={`https://wa.me/${SITE.whatsapp.number}?text=${encodeURIComponent(SITE.whatsapp.defaultMessage)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:flex items-center gap-2 bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-all duration-200 shadow-md hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0"
        aria-label="Solicitar por WhatsApp"
      >
        <!-- WhatsApp Icon -->
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Solicitar por WhatsApp
      </a>

      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="lg:hidden p-2 rounded-xl text-[#4B5563] hover:bg-gray-100 hover:text-brand-500 transition-colors duration-200"
      >
        <svg id="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg id="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="hidden" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación"
    class="lg:hidden bg-white/95 backdrop-blur-md border-t border-gray-100 shadow-xl overflow-hidden max-h-0 opacity-0 pointer-events-none transition-all duration-300 ease-in-out"
  >
    <nav class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-1" aria-label="Menú móvil">
      {
        SITE.nav.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-link px-4 py-3 text-base font-medium text-[#374151] hover:text-brand-500 hover:bg-brand-50 rounded-xl transition-all duration-200"
          >
            {item.label}
          </a>
        ))
      }
      <div class="pt-2 border-t border-gray-100 mt-2">
        <a
          href={`https://wa.me/${SITE.whatsapp.number}?text=${encodeURIComponent(SITE.whatsapp.defaultMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 bg-brand-500 hover:bg-brand-600 text-white font-semibold px-4 py-3.5 rounded-xl transition-all duration-200 shadow-md"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Solicitar por WhatsApp
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // ── Scroll glassmorphism ──────────────────────────────────────
  const header = document.getElementById('header')!;
  const navInner = document.getElementById('nav-inner')!;

  function updateHeader() {
    if (window.scrollY > 20) {
      header.classList.add('bg-white/90', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-gray-100/80');
      header.classList.remove('bg-transparent');
    } else {
      header.classList.remove('bg-white/90', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-gray-100/80');
      header.classList.add('bg-transparent');
    }
  }

  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  // ── Mobile menu toggle ────────────────────────────────────────
  const btn = document.getElementById('mobile-menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const iconMenu = document.getElementById('icon-menu')!;
  const iconClose = document.getElementById('icon-close')!;

  let isOpen = false;

  function toggleMenu(show?: boolean) {
    isOpen = show !== undefined ? show : !isOpen;
    btn.setAttribute('aria-expanded', String(isOpen));
    iconMenu.classList.toggle('hidden', isOpen);
    iconClose.classList.toggle('hidden', !isOpen);

    if (isOpen) {
      menu.classList.remove('max-h-0', 'opacity-0', 'pointer-events-none');
      menu.classList.add('max-h-96', 'opacity-100', 'pointer-events-auto');
    } else {
      menu.classList.remove('max-h-96', 'opacity-100', 'pointer-events-auto');
      menu.classList.add('max-h-0', 'opacity-0', 'pointer-events-none');
    }
  }

  btn.addEventListener('click', () => toggleMenu());

  // Close mobile menu on nav link click
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => toggleMenu(false));
  });
</script>
