---
import { SITE } from '../config/site';

const { requirements } = SITE;

// Iconos SVG inline para cada tipo de requisito
const icons: Record<string, string> = {
  'id-card': `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><circle cx="8" cy="12" r="2"/><path d="M14 11h4M14 15h4"/></svg>`,
  'banknote': `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>`,
  'university': `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="22" x2="21" y2="22"/><line x1="6" y1="18" x2="6" y2="11"/><line x1="10" y1="18" x2="10" y2="11"/><line x1="14" y1="18" x2="14" y2="11"/><line x1="18" y1="18" x2="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>`,
  'phone': `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.07 6.07l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.72 17z"/></svg>`,
  'user-check': `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>`,
  'file-text': `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
};
---

<!-- ===== SECCIÓN REQUISITOS ===== -->
<section
  id="requisitos"
  class="py-20 lg:py-28 bg-white"
  aria-label="Requisitos mínimos para solicitar un préstamo"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">

      <!-- Columna izquierda: Texto informativo -->
      <div class="lg:sticky lg:top-24">
        <span class="inline-flex items-center gap-2 bg-green-50 text-green-700 text-sm font-semibold px-4 py-2 rounded-full mb-6 border border-green-200">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Califica fácilmente
        </span>

        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#111827] mb-5">
          Requisitos mínimos para tu crédito
        </h2>
        <p class="text-lg text-[#4B5563] leading-relaxed mb-8">
          En Credixa33 queremos que accedas a tu préstamo con el menor esfuerzo posible. Estos son los requisitos básicos que necesitamos verificar.
        </p>

        <!-- Stats de confianza -->
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-[#F3F4F6] rounded-2xl p-5">
            <p class="text-3xl font-extrabold text-brand-500 mb-1">24h</p>
            <p class="text-sm text-[#4B5563] font-medium">Tiempo máximo de respuesta</p>
          </div>
          <div class="bg-[#F3F4F6] rounded-2xl p-5">
            <p class="text-3xl font-extrabold text-brand-500 mb-1">+500</p>
            <p class="text-sm text-[#4B5563] font-medium">Clientes satisfechos en RD</p>
          </div>
          <div class="bg-[#F3F4F6] rounded-2xl p-5">
            <p class="text-3xl font-extrabold text-brand-500 mb-1">0%</p>
            <p class="text-sm text-[#4B5563] font-medium">Comisión por solicitud</p>
          </div>
          <div class="bg-[#F3F4F6] rounded-2xl p-5">
            <p class="text-3xl font-extrabold text-brand-500 mb-1">100%</p>
            <p class="text-sm text-[#4B5563] font-medium">Proceso digital y remoto</p>
          </div>
        </div>
      </div>

      <!-- Columna derecha: Lista de requisitos -->
      <div>
        <div class="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden">
          <!-- Header de la card -->
          <div class="bg-gradient-to-r from-brand-500 to-brand-600 px-7 py-5">
            <h3 class="text-white font-bold text-lg">Lista de requisitos</h3>
            <p class="text-white/80 text-sm mt-1">Documentos y condiciones necesarias</p>
          </div>

          <!-- Items -->
          <ul class="divide-y divide-gray-100" role="list">
            {
              requirements.map((req) => (
                <li class="flex items-start gap-4 px-7 py-5 hover:bg-gray-50/70 transition-colors duration-150 group">
                  <!-- Icono -->
                  <div class={`flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center ${req.required ? 'bg-brand-50 text-brand-600' : 'bg-gray-100 text-[#6B7280]'} group-hover:scale-105 transition-transform duration-200`}>
                    <Fragment set:html={icons[req.icon] ?? icons['file-text']} />
                  </div>

                  <!-- Texto -->
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-[#111827] leading-snug">{req.text}</p>
                    {req.required ? (
                      <span class="inline-flex items-center gap-1 mt-1.5 text-xs font-medium text-brand-600">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                        Requerido
                      </span>
                    ) : (
                      <span class="inline-flex items-center gap-1 mt-1.5 text-xs font-medium text-[#9CA3AF]">
                        Según el monto
                      </span>
                    )}
                  </div>

                  <!-- Check decorativo -->
                  <div class={`flex-shrink-0 w-6 h-6 rounded-full flex items-center justify-center ${req.required ? 'bg-green-100' : 'bg-gray-100'}`} aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke={req.required ? '#22c55e' : '#9CA3AF'} stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                  </div>
                </li>
              ))
            }
          </ul>

          <!-- Footer de la card con CTA -->
          <div class="px-7 py-5 bg-gray-50 border-t border-gray-100">
            <p class="text-sm text-[#4B5563] mb-4">
              ¿Tienes dudas sobre si calificas? Contáctanos, con gusto te orientamos.
            </p>
            <a
              href={`https://wa.me/${SITE.whatsapp.number}?text=${encodeURIComponent('Hola Credixa33, quiero saber si califico para un prestamo personal. Me pueden orientar?')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-600 text-white text-sm font-bold px-5 py-3 rounded-xl transition-all duration-200 shadow-md hover:shadow-lg"
              aria-label="Consultar si califico por WhatsApp"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Consultar si califico
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
