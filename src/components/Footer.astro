---
import { SITE } from '../config/site';
---

<!-- ===== FOOTER ===== -->
<footer class="bg-[#111827] text-white" role="contentinfo">

  <!-- Franja CTA superior -->
  <div class="bg-gradient-to-r from-brand-500 to-brand-600 py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">
        ¿Aún tienes dudas? Contáctanos ahora
      </h2>
      <p class="text-white/85 text-base mb-7">
        Nuestro equipo está disponible para orientarte y resolver todas tus preguntas sobre tu crédito personal.
      </p>
      <a
        href={`https://wa.me/${SITE.whatsapp.number}?text=${encodeURIComponent(SITE.whatsapp.defaultMessage)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-white text-brand-600 font-bold text-base px-7 py-4 rounded-2xl shadow-lg hover:shadow-xl hover:bg-brand-50 hover:-translate-y-0.5 transition-all duration-200"
        aria-label="Contactar por WhatsApp"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Escríbenos por WhatsApp
      </a>
    </div>
  </div>

  <!-- Cuerpo del footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">

      <!-- Columna 1: Marca -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="#inicio" class="flex items-center gap-2.5 mb-5 group" aria-label="Credixa33 - Inicio">
          <div class="w-10 h-10 bg-brand-500 rounded-xl flex items-center justify-center shadow-md group-hover:bg-brand-600 transition-colors duration-200">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
              <path d="M9 12h6"/>
            </svg>
          </div>
          <span class="text-xl font-extrabold tracking-tight">
            Credixa<span class="text-brand-500">33</span>
          </span>
        </a>
        <p class="text-sm text-gray-400 leading-relaxed mb-5">
          Soluciones de crédito personal rápidas y confiables para empleados, emprendedores y pensionados en República Dominicana.
        </p>
        <!-- Redes sociales placeholder -->
        <div class="flex items-center gap-3">
          <a
            href={`https://wa.me/${SITE.whatsapp.number}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 bg-white/10 hover:bg-[#25D366] rounded-xl flex items-center justify-center transition-all duration-200 group"
            aria-label="WhatsApp de Credixa33"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="white" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Columna 2: Navegación -->
      <div>
        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-5">Navegación</h3>
        <nav aria-label="Navegación del pie de página">
          <ul class="space-y-3" role="list">
            {SITE.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-gray-400 hover:text-brand-400 transition-colors duration-200 flex items-center gap-1.5 group"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-hover:opacity-100 transition-opacity duration-200" aria-hidden="true">
                    <polyline points="9 18 15 12 9 6"/>
                  </svg>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Columna 3: Horarios -->
      <div>
        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-5">Horarios de Atención</h3>
        <ul class="space-y-3" role="list">
          <li class="flex items-start gap-3 text-sm text-gray-400">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FF7E20" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{SITE.hours.weekdays}</span>
          </li>
          <li class="flex items-start gap-3 text-sm text-gray-400">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FF7E20" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{SITE.hours.saturday}</span>
          </li>
          <li class="flex items-start gap-3 text-sm text-gray-400">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{SITE.hours.sunday}</span>
          </li>
        </ul>

        <div class="mt-6 inline-flex items-center gap-2 bg-green-900/30 border border-green-800/50 text-green-400 text-xs font-semibold px-3 py-2 rounded-xl">
          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse" aria-hidden="true"></span>
          WhatsApp disponible 24/7
        </div>
      </div>

      <!-- Columna 4: Cobertura y contacto -->
      <div>
        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-5">Contacto y Cobertura</h3>
        <ul class="space-y-4" role="list">
          <li class="flex items-start gap-3 text-sm text-gray-400">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FF7E20" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{SITE.coverage}</span>
          </li>
          <li>
            <a
              href={`https://wa.me/${SITE.whatsapp.number}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start gap-3 text-sm text-gray-400 hover:text-[#25D366] transition-colors duration-200"
              aria-label={`WhatsApp: ${SITE.whatsapp.display}`}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="mt-0.5 flex-shrink-0" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span>{SITE.whatsapp.display}</span>
            </a>
          </li>
          <li>
            <a
              href={`mailto:${SITE.email}`}
              class="flex items-start gap-3 text-sm text-gray-400 hover:text-brand-400 transition-colors duration-200"
              aria-label={`Email: ${SITE.email}`}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FF7E20" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <span>{SITE.email}</span>
            </a>
          </li>
        </ul>

        <!-- Rangos de préstamo -->
        <div class="mt-6 bg-white/5 rounded-xl px-4 py-3 border border-white/10">
          <p class="text-xs text-gray-500 mb-1">Montos disponibles</p>
          <p class="text-sm font-bold text-white">
            {SITE.loan.currency}{SITE.loan.min.toLocaleString('es-DO')} – {SITE.loan.currency}{SITE.loan.max.toLocaleString('es-DO')}
          </p>
        </div>
      </div>
    </div>

    <!-- Línea divisoria -->
    <div class="border-t border-white/10 pt-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm text-gray-500 text-center sm:text-left">
          © {new Date().getFullYear()} <strong class="text-gray-400">Credixa33</strong>. Todos los derechos reservados. República Dominicana.
        </p>
        <div class="flex items-center gap-4 text-xs text-gray-600">
          <span>Confidencialidad garantizada</span>
          <span class="w-1 h-1 bg-gray-700 rounded-full" aria-hidden="true"></span>
          <span>SSL Seguro</span>
          <span class="w-1 h-1 bg-gray-700 rounded-full" aria-hidden="true"></span>
          <span>Datos 100% protegidos</span>
        </div>
      </div>
    </div>
  </div>
</footer>
