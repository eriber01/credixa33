---
import { SITE } from '../config/site';

const { loan } = SITE;
const amounts = loan.sampleAmounts;
const freqs = loan.paymentFrequencies;
---

<!-- ===== MÓDULO CALCULADORA / SIMULADOR ===== -->
<section
  id="calculadora"
  class="py-20 lg:py-28 bg-white"
  aria-label="Simulador de préstamo"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header de sección -->
    <div class="text-center mb-12">
      <span class="inline-flex items-center gap-2 bg-brand-50 text-brand-600 text-sm font-semibold px-4 py-2 rounded-full mb-4 border border-brand-200">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="16" y2="11"/><line x1="8" y1="15" x2="12" y2="15"/>
        </svg>
        Simulador de Préstamo
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#111827] mb-4">
        Calcula tu cuota estimada
      </h2>
      <p class="text-lg text-[#4B5563] max-w-2xl mx-auto">
        Selecciona el monto que necesitas y la frecuencia de pago que más te convenga. Te contactamos por WhatsApp con tu propuesta personalizada.
      </p>
    </div>

    <!-- Calculadora Card -->
    <div class="bg-gradient-to-br from-[#FAFAFA] to-white rounded-3xl border border-gray-200 shadow-xl shadow-gray-100/80 overflow-hidden">
      <div class="grid lg:grid-cols-5 divide-y lg:divide-y-0 lg:divide-x divide-gray-100">

        <!-- Panel izquierdo: Selectores -->
        <div class="lg:col-span-3 p-7 lg:p-10">

          <!-- Monto -->
          <div class="mb-8">
            <label class="block text-sm font-semibold text-[#374151] mb-4">
              <span class="flex items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF7E20" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4H8"/><line x1="12" y1="6" x2="12" y2="8"/><line x1="12" y1="16" x2="12" y2="18"/>
                </svg>
                ¿Cuánto necesitas? <span class="text-[#9CA3AF] font-normal">(Selecciona un monto)</span>
              </span>
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5" role="group" aria-label="Selección de monto">
              {
                amounts.map((amount, i) => (
                  <button
                    type="button"
                    data-amount={amount}
                    class={`amount-btn text-sm font-semibold px-3 py-3.5 rounded-xl border-2 transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-1 ${i === 2 ? 'border-brand-500 bg-brand-50 text-brand-600' : 'border-gray-200 bg-white text-[#374151] hover:border-brand-300 hover:bg-brand-50/50 hover:text-brand-500'}`}
                    aria-pressed={i === 2 ? 'true' : 'false'}
                  >
                    {amount.toLocaleString('es-ES')}{SITE.loan.currency}
                  </button>
                ))
              }
            </div>
          </div>

          <!-- Frecuencia de pago -->
          <div class="mb-8">
            <label class="block text-sm font-semibold text-[#374151] mb-4">
              <span class="flex items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF7E20" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                Frecuencia de pago
              </span>
            </label>
            <div class="flex gap-2.5 flex-wrap" role="group" aria-label="Selección de frecuencia">
              {
                freqs.map((freq, i) => (
                  <button
                    type="button"
                    data-freq={freq.value}
                    class={`freq-btn flex-1 min-w-[90px] text-sm font-semibold px-4 py-3 rounded-xl border-2 transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-1 ${i === 2 ? 'border-brand-500 bg-brand-50 text-brand-600' : 'border-gray-200 bg-white text-[#374151] hover:border-brand-300 hover:bg-brand-50/50 hover:text-brand-500'}`}
                    aria-pressed={i === 2 ? 'true' : 'false'}
                  >
                    {freq.label}
                  </button>
                ))
              }
            </div>
          </div>

          <!-- Plazo -->
          <div>
            <label for="plazo-select" class="flex items-center gap-2 text-sm font-semibold text-[#374151] mb-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF7E20" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              Plazo deseado
            </label>
            <select
              id="plazo-select"
              class="w-full border-2 border-gray-200 hover:border-brand-300 focus:border-brand-500 focus:outline-none rounded-xl px-4 py-3 text-sm font-medium text-[#374151] bg-white transition-colors duration-150 cursor-pointer"
              aria-label="Selecciona el plazo"
            >
              <option value="1">1 mes</option>
              <option value="2">2 meses</option>
              <option value="3">3 meses</option>
              <option value="6" selected>6 meses</option>
              <option value="12">12 meses</option>
            </select>
          </div>
        </div>

        <!-- Panel derecho: Resultado -->
        <div class="lg:col-span-2 p-7 lg:p-10 flex flex-col justify-between bg-gradient-to-br from-brand-500 to-brand-600 text-white">
          <div>
            <p class="text-sm font-semibold opacity-80 uppercase tracking-wider mb-1">Estimado de cuota</p>
            <div id="cuota-display" class="text-4xl lg:text-5xl font-extrabold tracking-tight mb-1">
              368€
            </div>
            <p id="freq-label-display" class="text-sm opacity-80 font-medium mb-6">por mes</p>

            <div class="space-y-3">
              <div class="flex justify-between items-center bg-white/15 rounded-xl px-4 py-2.5 text-sm">
                <span class="opacity-90">Monto solicitado</span>
                <span id="monto-display" class="font-bold">2.000€</span>
              </div>
              <div class="flex justify-between items-center bg-white/15 rounded-xl px-4 py-2.5 text-sm">
                <span class="opacity-90">Plazo</span>
                <span id="plazo-display" class="font-bold">6 meses</span>
              </div>
              <div class="flex justify-between items-center bg-white/15 rounded-xl px-4 py-2.5 text-sm">
                <span class="opacity-90">Frecuencia</span>
                <span id="freq-display" class="font-bold">Mensual</span>
              </div>
            </div>

            <p class="mt-4 text-xs opacity-70 leading-relaxed">
              * Cuota estimada referencial. La tasa y cuota definitivas se confirman al momento de la aprobación.
            </p>
          </div>

          <!-- CTA WhatsApp -->
          <a
            id="calc-wa-btn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 flex items-center justify-center gap-2.5 bg-white text-brand-600 font-bold text-sm px-5 py-4 rounded-xl hover:bg-brand-50 transition-colors duration-200 shadow-lg"
            aria-label="Solicitar este crédito por WhatsApp"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Solicitar este crédito
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ waNumber: SITE.whatsapp.number, monthlyRate: SITE.loan.monthlyRate }}>
  let selectedAmount = 2000;
  let selectedFreq = 'mensual';
  let selectedPlazo = 6;

  const freqLabels = { semanal: 'semana', quincenal: 'quincena', mensual: 'mes' };
  const freqDisplayLabels = { semanal: 'Semanal', quincenal: 'Quincenal', mensual: 'Mensual' };
  const freqMultiplier = { semanal: 4.33, quincenal: 2.16, mensual: 1 };

  function formatCurrency(n) {
    return Math.round(n).toLocaleString('es-ES') + '€';
  }

  function computeCuota(amount, months, freq) {
    const r = monthlyRate;
    // Fórmula de cuota: A * [r(1+r)^n] / [(1+r)^n - 1]
    const cuotaMensual = months === 1
      ? amount * (1 + r)
      : amount * (r * Math.pow(1 + r, months)) / (Math.pow(1 + r, months) - 1);
    return cuotaMensual / freqMultiplier[freq];
  }

  function updateDisplay() {
    const cuota = computeCuota(selectedAmount, selectedPlazo, selectedFreq);
    document.getElementById('cuota-display').textContent = formatCurrency(cuota);
    document.getElementById('freq-label-display').textContent = `por ${freqLabels[selectedFreq]}`;
    document.getElementById('monto-display').textContent = formatCurrency(selectedAmount);
    document.getElementById('plazo-display').textContent = `${selectedPlazo} ${selectedPlazo === 1 ? 'mes' : 'meses'}`;
    document.getElementById('freq-display').textContent = freqDisplayLabels[selectedFreq];

    // Armar mensaje WhatsApp
    const msg = encodeURIComponent(
      `Hola Credixa33! Me interesa solicitar un prestamo con las siguientes caracteristicas:\n\n` +
      `* Monto: ${formatCurrency(selectedAmount)}\n` +
      `* Plazo: ${selectedPlazo} ${selectedPlazo === 1 ? 'mes' : 'meses'}\n` +
      `* Frecuencia de pago: ${freqDisplayLabels[selectedFreq]}\n` +
      `* Cuota estimada: ${formatCurrency(cuota)} por ${freqLabels[selectedFreq]}\n\n` +
      `Pueden orientarme sobre los requisitos y el proceso?`
    );
    document.getElementById('calc-wa-btn').href = `https://wa.me/${waNumber}?text=${msg}`;
  }

  // Botones de monto
  document.querySelectorAll('.amount-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      selectedAmount = parseInt(btn.dataset.amount);
      document.querySelectorAll('.amount-btn').forEach((b) => {
        b.classList.remove('border-brand-500', 'bg-brand-50', 'text-brand-600');
        b.classList.add('border-gray-200', 'bg-white', 'text-[#374151]');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('border-brand-500', 'bg-brand-50', 'text-brand-600');
      btn.classList.remove('border-gray-200', 'bg-white', 'text-[#374151]');
      btn.setAttribute('aria-pressed', 'true');
      updateDisplay();
    });
  });

  // Botones de frecuencia
  document.querySelectorAll('.freq-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      selectedFreq = btn.dataset.freq;
      document.querySelectorAll('.freq-btn').forEach((b) => {
        b.classList.remove('border-brand-500', 'bg-brand-50', 'text-brand-600');
        b.classList.add('border-gray-200', 'bg-white', 'text-[#374151]');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('border-brand-500', 'bg-brand-50', 'text-brand-600');
      btn.classList.remove('border-gray-200', 'bg-white', 'text-[#374151]');
      btn.setAttribute('aria-pressed', 'true');
      updateDisplay();
    });
  });

  // Select de plazo
  document.getElementById('plazo-select').addEventListener('change', (e) => {
    selectedPlazo = parseInt(e.target.value);
    updateDisplay();
  });

  // Inicializar
  updateDisplay();
</script>
