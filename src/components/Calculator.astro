---
import { SITE } from '../config/site';

const defaultAmount = 10000;
const defaultRate = 3;
const defaultMonths = 25;
---

<!-- ===== MÓDULO CALCULADORA / SIMULADOR ===== -->
<section
  id="calculadora"
  class="py-20 lg:py-28 bg-[#FAFAFA]"
  aria-label="Simulador de préstamo"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header de sección -->
    <div class="text-center mb-12">
      <span class="inline-flex items-center gap-2 bg-blue-50 text-[#0047BA] text-sm font-bold px-4 py-2 rounded-full mb-3 border border-blue-200 shadow-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="16" y2="11"/><line x1="8" y1="15" x2="12" y2="15"/>
        </svg>
        Simulador de Préstamo
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#111827]">
        Calcula tu préstamo
      </h2>
      <p class="text-base text-[#4B5563] mt-2 max-w-xl mx-auto">
        Ajusta el monto, tasa de interés y plazo en meses para simular tu cuota en tiempo real.
      </p>
    </div>

    <!-- Contenedor de las dos tarjetas (stack en mobile, lado a lado en desktop) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-stretch">

      <!-- Card 1: Calculadora Input & Sliders -->
      <div class="bg-white rounded-3xl border border-gray-200/90 shadow-sm p-6 sm:p-8 flex flex-col justify-between">
        <div>
          <h3 class="text-2xl font-bold text-[#111827] mb-6">
            Calculadora
          </h3>

          <!-- Monto del préstamo -->
          <div class="mb-7">
            <label for="loan-amount-input" class="block text-sm font-semibold text-[#374151] mb-2">
              Monto del préstamo
            </label>
            <div class="relative">
              <input
                type="number"
                id="loan-amount-input"
                value={defaultAmount}
                min="1000"
                max="100000"
                step="500"
                class="w-full bg-[#F8FAFC] border border-gray-200 hover:border-gray-300 focus:border-[#0047BA] focus:bg-white focus:outline-none rounded-xl px-4 py-3.5 text-base font-semibold text-[#111827] transition-all duration-150"
                placeholder="10000"
              />
              <span class="absolute right-4 top-1/2 -translate-y-1/2 text-sm font-semibold text-gray-400 select-none">
                {SITE.loan.currency}
              </span>
            </div>
            <p class="text-xs text-[#9CA3AF] mt-1.5 font-normal">
              Introduzca la cantidad (1.000€ - 100.000€)
            </p>
          </div>

          <!-- Tasa de interés anual -->
          <div class="mb-7">
            <div class="flex items-center justify-between text-sm font-semibold text-[#374151] mb-3">
              <span>Tasa de interés anual</span>
              <span class="text-[#111827] font-bold text-sm">
                <span id="rate-value-display">{defaultRate}</span>%
              </span>
            </div>
            <input
              type="range"
              id="rate-slider"
              min="0"
              max="15"
              step="0.5"
              value={defaultRate}
              class="range-slider w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer"
            />
            <div class="flex justify-between text-xs text-[#9CA3AF] font-medium mt-1.5">
              <span>0%</span>
              <span>15%</span>
            </div>
          </div>

          <!-- Meses -->
          <div>
            <div class="flex items-center justify-between text-sm font-semibold text-[#374151] mb-3">
              <span>Meses</span>
              <span class="text-[#111827] font-bold text-sm">
                <span id="months-value-display">{defaultMonths}</span> meses
              </span>
            </div>
            <input
              type="range"
              id="months-slider"
              min="4"
              max="160"
              step="1"
              value={defaultMonths}
              class="range-slider w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer"
            />
            <div class="flex justify-between text-xs text-[#9CA3AF] font-medium mt-1.5">
              <span>4</span>
              <span>160</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 2: Resumen Total -->
      <div class="bg-white rounded-3xl border border-gray-200/90 shadow-sm p-6 sm:p-8 flex flex-col justify-between">
        <!-- Contenido superior de la tarjeta -->
        <div>
          <!-- Header de la tarjeta -->
          <div class="flex items-center justify-between mb-5">
            <h3 class="text-xl font-bold text-[#111827]">
              Resumen Total
            </h3>
            <div class="w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-gray-500">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="18 15 12 9 6 15"/>
              </svg>
            </div>
          </div>

          <!-- Tabla cabecera -->
          <div class="bg-[#F1F5F9] rounded-xl px-4 py-2.5 flex justify-between text-xs font-bold text-[#475569] uppercase tracking-wider mb-4">
            <span>Concepto</span>
            <span>Total</span>
          </div>

          <!-- Fila 1: Monto Del Préstamo -->
          <div class="flex justify-between items-center py-2.5 text-sm">
            <span class="text-[#4B5563] font-medium">Monto Del Préstamo</span>
            <span id="summary-amount" class="text-[#111827] font-semibold">10.000,00 €</span>
          </div>
          <div class="border-b border-dashed border-gray-200 my-1"></div>

          <!-- Fila 2: Tasa De Interés Anual -->
          <div class="flex justify-between items-center py-2.5 text-sm">
            <span class="text-[#4B5563] font-medium">Tasa De Interés Anual</span>
            <span id="summary-rate" class="text-[#111827] font-semibold">3 %</span>
          </div>
          <div class="border-b border-dashed border-gray-200 my-1"></div>

          <!-- Fila 3: Meses -->
          <div class="flex justify-between items-center py-2.5 text-sm">
            <span class="text-[#4B5563] font-medium">Meses</span>
            <span id="summary-months" class="text-[#111827] font-semibold">25</span>
          </div>
          <div class="border-b border-dashed border-gray-200 my-2"></div>

          <!-- Fila Total (Cuota Mensual) -->
          <div class="flex justify-between items-center pt-3 pb-1">
            <span class="text-lg font-bold text-[#111827]">Total</span>
            <span id="summary-total" class="text-2xl font-extrabold text-[#0047BA]">413,13 €</span>
          </div>
          <p class="text-xs text-[#9CA3AF] text-right mb-6">
            cuota fija mensual estimada
          </p>
        </div>

        <!-- CTA WhatsApp -->
        <a
          id="calc-wa-btn"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2.5 bg-gradient-to-r from-[#C69214] via-[#D4AF37] to-[#B8860B] hover:from-[#B8860B] hover:to-[#9E6D08] text-white font-bold text-sm px-6 py-4 rounded-2xl shadow-lg shadow-amber-600/25 hover:shadow-xl hover:shadow-amber-600/35 transition-all duration-200"
          aria-label="Solicitar este préstamo por WhatsApp"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Solicitar este préstamo por WhatsApp
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .range-slider {
    -webkit-appearance: none;
    width: 100%;
    height: 8px;
    border-radius: 5px;
    background: #E2E8F0;
    outline: none;
  }
  .range-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #0047BA;
    border: 3px solid #ffffff;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0,0,0,0.25);
    transition: transform 0.15s ease;
  }
  .range-slider::-webkit-slider-thumb:hover {
    transform: scale(1.15);
  }
  .range-slider::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #0047BA;
    border: 3px solid #ffffff;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0,0,0,0.25);
  }
</style>

<script define:vars={{ waNumber: SITE.whatsapp.number, currencySymbol: SITE.loan.currency }}>
  const amountInput = document.getElementById('loan-amount-input');
  const rateSlider = document.getElementById('rate-slider');
  const monthsSlider = document.getElementById('months-slider');

  const rateValueDisplay = document.getElementById('rate-value-display');
  const monthsValueDisplay = document.getElementById('months-value-display');

  const summaryAmount = document.getElementById('summary-amount');
  const summaryRate = document.getElementById('summary-rate');
  const summaryMonths = document.getElementById('summary-months');
  const summaryTotal = document.getElementById('summary-total');
  const calcWaBtn = document.getElementById('calc-wa-btn');

  function updateSliderBackground(slider, color = '#0047BA') {
    const min = Number(slider.min) || 0;
    const max = Number(slider.max) || 100;
    const val = Number(slider.value);
    const percentage = ((val - min) / (max - min)) * 100;
    slider.style.background = `linear-gradient(to right, ${color} 0%, ${color} ${percentage}%, #E2E8F0 ${percentage}%, #E2E8F0 100%)`;
  }

  function calculateMonthlyPayment(principal, annualRatePercent, months) {
    if (months <= 0 || principal <= 0) return 0;
    const monthlyRate = (annualRatePercent / 100) / 12;
    if (monthlyRate === 0) {
      return principal / months;
    }
    const factor = Math.pow(1 + monthlyRate, months);
    return (principal * monthlyRate * factor) / (factor - 1);
  }

  function formatMoney(amount) {
    return amount.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + currencySymbol;
  }

  function recalculate() {
    let amount = parseFloat(amountInput.value) || 0;
    let rate = parseFloat(rateSlider.value) || 0;
    let months = parseInt(monthsSlider.value) || 1;

    rateValueDisplay.textContent = rate;
    monthsValueDisplay.textContent = months;

    updateSliderBackground(rateSlider, '#0047BA');
    updateSliderBackground(monthsSlider, '#0047BA');

    summaryAmount.textContent = formatMoney(amount);
    summaryRate.textContent = `${rate} %`;
    summaryMonths.textContent = months;

    const monthlyPayment = calculateMonthlyPayment(amount, rate, months);
    summaryTotal.textContent = formatMoney(monthlyPayment);

    // WhatsApp pre-filled message
    const msg = encodeURIComponent(
      `Hola Credixa33! He calculado mi préstamo en la web con los siguientes datos:\n\n` +
      `* Monto solicitado: ${formatMoney(amount)}\n` +
      `* Tasa de interés anual: ${rate} %\n` +
      `* Plazo: ${months} meses\n` +
      `* Cuota mensual estimada: ${formatMoney(monthlyPayment)}\n\n` +
      `¿Cómo puedo iniciar el trámite?`
    );
    calcWaBtn.href = `https://wa.me/${waNumber}?text=${msg}`;
  }

  amountInput.addEventListener('input', recalculate);
  rateSlider.addEventListener('input', recalculate);
  monthsSlider.addEventListener('input', recalculate);

  // Initial execution
  recalculate();
</script>
