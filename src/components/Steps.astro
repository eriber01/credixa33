---
// Steps.astro — Proceso en 3 pasos

const steps = [
  {
    number: "01",
    title: "Llena tu solicitud",
    description:
      "Completa nuestro formulario en línea o escríbenos por WhatsApp con tu nombre, DNI/NIE y monto deseado. Todo en menos de 5 minutos.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
    color: "bg-blue-50 text-blue-600",
    border: "border-blue-100",
    badge: "bg-blue-500",
  },
  {
    number: "02",
    title: "Aprobación ágil",
    description:
      "Nuestro equipo evalúa tu solicitud en tiempo récord. Recibirás la respuesta con el monto aprobado y las condiciones en 24 horas o menos.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>`,
    color: "bg-gold-50 text-gold-600",
    border: "border-gold-200",
    badge: "bg-gold-500",
  },
  {
    number: "03",
    title: "Recibe tus fondos",
    description:
      "Una vez aprobado y firmado el acuerdo, realizamos el depósito directo a tu cuenta bancaria española de forma segura y ágil.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>`,
    color: "bg-green-50 text-green-600",
    border: "border-green-100",
    badge: "bg-green-500",
  },
];
---

<!-- ===== SECCIÓN CÓMO FUNCIONA ===== -->
<section
  id="como-funciona"
  class="py-20 lg:py-28 bg-[#F3F4F6]"
  aria-label="Cómo funciona el proceso de préstamo"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-14">
      <span class="inline-flex items-center gap-2 bg-amber-50 text-[#855B04] text-sm font-bold px-4 py-2 rounded-full mb-4 border border-amber-200 shadow-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C69214" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
        Proceso simple y transparente
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#111827] mb-4">
        ¿Cómo funciona?
      </h2>
      <p class="text-lg text-[#4B5563] max-w-xl mx-auto">
        Obtener tu préstamo en Credixa33 es rápido, fácil y sin complicaciones. Solo sigue estos 3 pasos.
      </p>
    </div>

    <!-- Grid de pasos -->
    <div class="grid md:grid-cols-3 gap-6 lg:gap-8 relative">

      <!-- Línea conectora decorativa (solo desktop) -->
      <div class="hidden md:block absolute top-14 left-[calc(33.33%+1rem)] right-[calc(33.33%+1rem)] h-0.5 bg-gradient-to-r from-blue-300 via-[#C69214] to-emerald-300 z-0" aria-hidden="true"></div>

      {
        steps.map((step, i) => (
          <article class="relative bg-white rounded-3xl border border-gray-200 p-7 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group z-10">

            <!-- Número del paso -->
            <div class={`inline-flex items-center justify-center w-14 h-14 rounded-2xl ${step.color} border ${step.border} mb-5 group-hover:scale-105 transition-transform duration-200`}>
              <Fragment set:html={step.icon} />
            </div>

            <!-- Badge de número -->
            <div class={`absolute top-5 right-5 w-8 h-8 ${step.badge} text-white text-xs font-extrabold rounded-full flex items-center justify-center shadow-md`}>
              {i + 1}
            </div>

            <h3 class="text-lg font-bold text-[#111827] mb-3">
              {step.title}
            </h3>
            <p class="text-[#4B5563] text-sm leading-relaxed">
              {step.description}
            </p>

            <!-- Indicador inferior -->
            <div class={`mt-5 w-8 h-1 ${step.badge} rounded-full group-hover:w-14 transition-all duration-300`} aria-hidden="true"></div>
          </article>
        ))
      }
    </div>

    <!-- CTA inferior -->
    <div class="text-center mt-12">
      <p class="text-[#4B5563] mb-5 text-base">
        ¿Listo para comenzar? El proceso completo toma menos de <strong class="text-[#111827]">24 horas</strong>.
      </p>
      <a
        href="#contacto"
        class="inline-flex items-center gap-2.5 bg-gradient-to-r from-[#C69214] via-[#D4AF37] to-[#B8860B] hover:from-[#B8860B] hover:to-[#9E6D08] text-white font-bold text-base px-8 py-4 rounded-2xl shadow-lg shadow-amber-600/30 hover:shadow-xl hover:shadow-amber-600/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
      >
        Comenzar ahora
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>
  </div>
</section>
